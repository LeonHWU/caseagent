{
  "name": "case-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "case": "node --env-file-if-exists=.env --import tsx src/cli.ts",
    "mcp": "node --env-file-if-exists=.env --import tsx src/mcp.ts",
    "extract": "uv run scripts/extract.py",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p .",
    "eval:edge": "node --env-file-if-exists=.env --import tsx \"evals/edge-cases/run.ts\"",
    "eval:process": "node --env-file-if-exists=.env --import tsx \"evals/Process Reward/run.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@modelcontextprotocol/sdk": "1.32.0",
    "pdfjs-dist": "6.3.289",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "25.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
