# Required.
ANTHROPIC_API_KEY=
# Optional. Default: claude-sonnet-5-5 (fast; the batch must finish inside 30 minutes).
MODEL=claude-sonnet-5-5
# Optional. PDFs up to this size (MB) go to Claude as the PDF itself; larger ones go as extracted text. Default: 5.
NATIVE_PDF_MAX_MB=5
# Optional. Small model that reads a landlord's reply to an approval request; assign_contractor needs its "approved". Default: claude-haiku-5-5.
APPROVAL_MODEL=claude-haiku-5-5
